APP_NAME=Chai House Feedback Studio
APP_PUBLIC_URL=http://127.0.0.1:8000
DATABASE_PATH=data/chaihouse-feedback.db
UPLOAD_DIR=data/uploads
WEBHOOK_TOKEN=

# Ollama + Jev / TypeSafe decision endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DECISION_MODEL=nimble
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=12

# Optional Twilio SMS. If these are blank, urgent alerts are logged in the app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE_NUMBER=+918073464430

# Set the public responder URL to enable the Google Form QR on the owner dashboard.
# Leave blank to keep the QR disabled and use /feedback as a local preview.
GOOGLE_FORM_URL=
