APP_NAME=Chai House Feedback Studio
APP_PUBLIC_URL=http://127.0.0.1:8000
DATABASE_PATH=data/chaihouse-feedback.db
UPLOAD_DIR=data/uploads
WEBHOOK_TOKEN=

# Ollama + Jev / TypeSafe decision endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DECISION_MODEL=nimble
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=12

# Optional Twilio SMS. If these are blank, urgent alerts are logged in the app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE_NUMBER=

# Set to a public Google Form URL to make the generated QR open Google Forms.
# Leave blank to use the built-in mobile-friendly feedback form.
GOOGLE_FORM_URL=
